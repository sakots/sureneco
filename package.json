{
  "name": "sureneco",
  "version": "0.5.0",
  "private": true,
  "description": "5ch雀魂スレッドの友人戦募集通知",
  "author": "sakots",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && node scripts/build-main.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "check": "pnpm test && pnpm build && pnpm theme:check && pnpm format:check && git diff --check",
    "package:linux": "pnpm check && pnpm exec install-electron && electron-builder --config electron-builder.config.mjs --linux --publish never",
    "package:win": "pnpm check && pnpm exec install-electron && electron-builder --config electron-builder.config.mjs --win --publish never",
    "format": "prettier --write src tests scripts vite.config.ts tsconfig.json package.json electron-builder.config.mjs",
    "format:check": "prettier --check src tests scripts vite.config.ts tsconfig.json package.json electron-builder.config.mjs"
  },
  "build": {
    "appId": "io.github.sakots.sureneco",
    "productName": "sureneco",
    "publish": {
      "provider": "github",
      "owner": "sakots",
      "repo": "sureneco"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "resources/icon.png",
      "maintainer": "sakots",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "${name}_v${version}_${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${name}_v${version}.${ext}"
    },
    "win": {
      "artifactName": "${name}_v${version}_win.${ext}",
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "include": "resources/installer.nsh",
      "artifactName": "${name}_v${version}_Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "sureneco.desktop"
}
