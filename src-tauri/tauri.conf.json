{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sureneco",
  "version": "../package.json",
  "identifier": "io.github.sakots.sureneco",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "sureneco",
        "width": 1120,
        "height": 820,
        "minWidth": 400,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "../resources/installer.nsh",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sureneco-notification"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4RkYzMzMxNzFFN0E3NTMKUldSVHArZHhNVFAvZU1RdFZkNHBwWm5Sd2phVFR4UXRwczZmSk1sWk1MZVdwZVVuL0daYlBSS1kK",
      "endpoints": [
        "https://github.com/sakots/sureneco/releases/latest/download/latest.json"
      ]
    }
  }
}
