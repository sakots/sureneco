# Managed by sureneco encrypted backup installer.
[Unit]
Description=Publish encrypted backup %i outcome
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/sureneco-backup-status %i
TimeoutStartSec=65s
TimeoutStopSec=5s
KillMode=control-group
RuntimeDirectory=sureneco-backup-status
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StandardOutput=null
StandardError=journal
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/sureneco-backup-status
NoNewPrivileges=true
