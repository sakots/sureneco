[Unit]
Description=sureneco notification server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sureneco
Group=sureneco
WorkingDirectory=/opt/sureneco
EnvironmentFile=/etc/sureneco/server.env
ExecStart=/usr/bin/node /opt/sureneco/dist/server/main.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
StateDirectory=sureneco
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sureneco
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
